# Configuration for scripts/compare-ec2/compare-ec2.sh.
#
# Copy to ~/.config/succinctly/compare-ec2.env (or point COMPARE_EC2_CONFIG at another path) and
# fill in your own values. Keep the real file out of the repository: it names your account's
# resources.

# AWS CLI profile to use (optional; the default credential chain otherwise).
AWS_PROFILE=

# Region to run in. It must offer the instance type you choose.
COMPARE_REGION=us-east-1

# An S3 bucket name you own (bucket names are global). `setup` creates it if it does not exist,
# with all public access blocked. Bake logs, run logs and results are written under it.
COMPARE_BUCKET=

# Prefix for the IAM role, instance profile, security group, image names and tags.
COMPARE_NAME=succinctly-compare

# Repository the instance clones; the commit under test must be reachable from it.
COMPARE_REPO_URL=https://github.com/rust-works/succinctly.git

# Default instance type for `bake` and `run`. Graviton4 (Neoverse-V2): c8g.2xlarge has 16 GiB,
# the least that fits the 1 GB tier (`--huge`). An x86_64 type bakes an x86_64 image.
COMPARE_INSTANCE_TYPE=c8g.2xlarge

# Root volume size in GiB for bake and run instances (source checkout, release build, the two
# pinned jq builds and ~3.2 GB of generated inputs for --full --huge).
COMPARE_ROOT_GB=40

# Subnet to launch in (optional). It must give the instance outbound internet access: a public
# IPv4 address (the default subnets do) or a NAT gateway. Default: a default subnet in an
# availability zone that offers the instance type.
COMPARE_SUBNET=
